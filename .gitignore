# macOS
/macos/Flutter/Flutter-Release.podspec
/macos/Flutter/GeneratedPluginRegistrant.*
**/macos/Pods/

# Linux
linux/flutter/ephemeral/

# Windows
windows/flutter/ephemeral/

# Web
/web/dart_js_shims/
.dart_tool/dartpad_log.txt

